impl LoadedData {
    pub fn as_slice(&self) -> &[u8] {
        match self {
            LoadedData::Aligned(buffer) => buffer.as_slice(),
            LoadedData::Mapped(buffer) => buffer.as_slice(),
        }
    }
}

impl Deref for LoadedData {
    type Target = [u8];

    fn deref(&self) -> &Self::Target {
